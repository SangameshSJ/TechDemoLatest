pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'], description: 'Deployment Environment')
        booleanParam(name: 'APPROVE_PRODUCTION', defaultValue: false, description: 'Approve Production Deployment')
    }

    environment {
        AWS_CREDENTIALS = credentials('aws-credentials')
        STACK_NAME = "${params.ENVIRONMENT}"
        SSH_KEY = credentials("production-bastion-key")
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Load Environment Outputs') {
            steps {
                script {
                    def jsonFile = "${params.ENVIRONMENT}-outputs.json"
                    echo "Looking for file: ${jsonFile}"
                    def jsonContent = readFile(file: jsonFile)
                    def jsonSlurper = new groovy.json.JsonSlurper()
                    def outputs = jsonSlurper.parseText(jsonContent)
                    env.BASTION_HOST = outputs.bastion_public_ip
                    env.APP1_HOST = outputs.app1_private_ip
                    env.APP2_HOST = outputs.app2_private_ip
                }
            }
        }

        stage('Build App 1') {
            steps {
                dir('applications/app1') {
                    sh 'docker build -t app1:latest .'
                }
            }
        }

        stage('Build App 2') {
            steps {
                dir('applications/app2') {
                    sh 'docker build -t app2:latest .'
                }
            }
        }

        stage('Save Docker Images') {
            steps {
                sh 'docker save -o app1.tar app1:latest'
                sh 'docker save -o app2.tar app2:latest'
            }
        }

        stage('Setup SSH on Bastion') {
            steps {
                sh 'chmod 600 $SSH_KEY'
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no $SSH_KEY ec2-user@${BASTION_HOST}:/tmp/app_key'
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        chmod 600 /tmp/app_key
                    "
                '''
            }
        }

        stage('Transfer to Bastion') {
            steps {
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app1.tar ec2-user@${BASTION_HOST}:/tmp/'
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app2.tar ec2-user@${BASTION_HOST}:/tmp/'
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        scp -i /tmp/app_key -o StrictHostKeyChecking=no /tmp/app1.tar ec2-user@${APP1_HOST}:/tmp/
                        scp -i /tmp/app_key -o StrictHostKeyChecking=no /tmp/app2.tar ec2-user@${APP2_HOST}:/tmp/
                    "
                '''
            }
        }

        stage('Deploy App 1') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@${APP1_HOST} '
                            sudo docker load -i /tmp/app1.tar
                            sudo docker stop app1 || true
                            sudo docker rm app1 || true
                            sudo docker run -d --name app1 -p 80:80 app1:latest
                            rm /tmp/app1.tar
                        '
                    "
                '''
            }
        }

        stage('Deploy App 2') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@${APP2_HOST} '
                            sudo docker load -i /tmp/app2.tar
                            sudo docker stop app2 || true
                            sudo docker rm app2 || true
                            sudo docker run -d --name app2 -p 80:80 app2:latest
                            rm /tmp/app2.tar
                        '
                    "
                '''
            }
        }

        stage('Verify Deployments') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@${APP1_HOST} '
                            echo \"App 1 Container Status:\"
                            sudo docker ps | grep app1
                            if curl -s -o /dev/null -w \"%{http_code}\" http://localhost:80/ | grep -q 200; then
                                echo \"Application 1 is responding with HTTP 200\"
                                exit 0
                            else
                                echo \"Application 1 is not responding correctly\"
                                exit 1
                            fi
                        '
                    "

                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@${APP2_HOST} '
                            echo \"App 2 Container Status:\"
                            sudo docker ps | grep app2
                            if curl -s -o /dev/null -w \"%{http_code}\" http://localhost:80/ | grep -q 200; then
                                echo \"Application 2 is responding with HTTP 200\"
                                exit 0
                            else
                                echo \"Application 2 is not responding correctly\"
                                exit 1
                            fi
                        '
                    "
                '''
            }
        }

        stage('Collect Deployment Logs') {
            steps {
                script {
                    try {
                        // Verify variables exist before use
                        if (!env.BASTION_HOST || !env.APP1_HOST || !env.APP2_HOST) {
                            error("Missing required host variables")
                        }

                        // App1 logs
                        def app1Logs = sh(script: """
                            echo "Collecting App1 logs..."
                            ssh -i ${env.SSH_KEY} -o StrictHostKeyChecking=no ec2-user@${env.BASTION_HOST} << 'BASTION_EOF'
                                ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@${env.APP1_HOST} << 'APP_EOF'
                                    echo "Collecting App1 container logs..."
                                    sudo docker logs app1 > /tmp/app1-deployment.log 2>&1 || echo "Failed to get docker logs"
                                    
                                    if command -v aws &> /dev/null; then
                                        AWS_REGION=us-east-2
                                        
                                        aws logs create-log-group --log-group-name app-instance-logs --region \$AWS_REGION || true
                                        aws logs create-log-stream --log-group-name app-instance-logs --log-stream-name app1-deployment-logs --region \$AWS_REGION || true
                                        
                                        if [ -f /tmp/app1-deployment.log ]; then
                                            LOG_CONTENT=\$(cat /tmp/app1-deployment.log | jq -R -s -c '.')
                                            TIMESTAMP=\$(date +%s000)
                                            
                                            LOG_EVENT="[{\\\\"timestamp\\\\": \$TIMESTAMP, \\\\"message\\\\": \$LOG_CONTENT}]"
                                            
                                            aws logs put-log-events \\
                                                --log-group-name app-instance-logs \\
                                                --log-stream-name app1-deployment-logs \\
                                                --log-events "\$LOG_EVENT" \\
                                                --region \$AWS_REGION || echo "Failed to upload logs, but continuing"
                                        else
                                            echo "Log file not found at /tmp/app1-deployment.log"
                                        fi
                                    else
                                        echo "AWS CLI not found, skipping log upload"
                                    fi
        APP_EOF
        BASTION_EOF
                            echo "App1 logs collected"
                        """, returnStdout: true)

                        // Similar implementation for App2 logs...
                        
                        echo "${app1Logs}"
                    } catch (Exception e) {
                        echo "WARNING: Failed to collect deployment logs: ${e.message}"
                        // Continue pipeline despite log collection failure
                    }
                }
            }
        }


        stage('Cleanup SSH Key') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        rm -f /tmp/app_key || true
                    "
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment completed successfully!"
        }
        failure {
            echo "Deployment failed. Please check the logs for more details."
            sh '''
                ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                    rm -f /tmp/app_key || true
                " || true
            '''
        }
        always {
            sh '''
                docker rmi app1:latest || true
                docker rmi app2:latest || true
                rm -f app1.tar || true
                rm -f app2.tar || true
            '''
            cleanWs()
        }
    }
}
pipeline {
    agent any
    
    environment {
        // Define environment variables
        BASTION_HOST = credentials('bastion-host-ip')
        SSH_KEY = credentials('bastion-ssh-key')
    }
    
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        
        stage('Load Outputs') {
            steps {
                script {
                    // Use fileExists and readFile instead of readJSON
                    if (fileExists('outputs.json')) {
                        def outputsJson = readFile('outputs.json')
                        env.BASTION_HOST = sh(
                            script: "echo '${outputsJson}' | jq -r '.bastion_public_ip'",
                            returnStdout: true
                        ).trim()
                    }
                }
            }
        }
        
        stage('Build App 1') {
            steps {
                dir('applications/app1') {
                    sh 'docker build -t app1:latest .'
                }
            }
        }
        
        stage('Build App 2') {
            steps {
                dir('applications/app2') {
                    sh 'docker build -t app2:latest .'
                }
            }
        }
        
        stage('Save Docker Images') {
            steps {
                sh 'docker save -o app1.tar app1:latest'
                sh 'docker save -o app2.tar app2:latest'
            }
        }
        
        stage('Setup SSH on Bastion') {
            steps {
                // Ensure SSH key has correct permissions
                sh 'chmod 600 $SSH_KEY'
            }
        }
        
        stage('Transfer to Bastion') {
            steps {
                // Use the environment variable for bastion host
                sh """
                    scp -i $SSH_KEY -o StrictHostKeyChecking=no app1.tar app2.tar ec2-user@${BASTION_HOST}:/tmp/
                """
            }
        }
        
        stage('Deploy App 1') {
            steps {
                sh """
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} '
                        docker load -i /tmp/app1.tar
                        docker run -d -p 8081:80 app1:latest
                    '
                """
            }
        }
        
        stage('Deploy App 2') {
            steps {
                sh """
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} '
                        docker load -i /tmp/app2.tar
                        docker run -d -p 8082:80 app2:latest
                    '
                """
            }
        }
        
        stage('Verify Deployments') {
            steps {
                sh """
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} '
                        curl http://localhost:8081
                        curl http://localhost:8082
                    '
                """
            }
        }
        
        stage('Cleanup SSH Key') {
            steps {
                sh """
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} '
                        rm -f /tmp/app1.tar /tmp/app2.tar
                    '
                """
            }
        }
    }
    
    post {
        always {
            // Clean up local Docker images
            sh 'docker rmi app1:latest || true'
            sh 'docker rmi app2:latest || true'
            sh 'rm -f app1.tar app2.tar'
            
            // Clean workspace
            cleanWs()
        }
    }
}
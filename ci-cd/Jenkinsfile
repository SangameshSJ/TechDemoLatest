pipeline {
    agent any

    environment {
        AWS_CREDENTIALS = credentials('aws-credentials')
        SSH_KEY = credentials('bastion-key')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature-branch',
                    url: 'https://github.com/SangameshSJ/TechDemoLatest.git',
                    credentialsId: 'github-https-token'
            }
        }

        stage('Load Outputs') {
            steps {
                script {
                    // Use readJSON to load the outputs.json file
                    def outputs = readJSON file: 'outputs.json'
                    env.BASTION_HOST = outputs.bastion_public_ip
                    env.APP1_HOST = outputs.app1_private_ip
                    env.APP2_HOST = outputs.app2_private_ip
                }
            }
        }

        stage('Build App 1') {
            steps {
                dir('applications/app1') {
                    sh 'docker build -t app1:latest .'
                }
            }
        }

        stage('Build App 2') {
            steps {
                dir('applications/app2') {
                    sh 'docker build -t app2:latest .'
                }
            }
        }

        stage('Save Docker Images') {
            steps {
                sh 'docker save -o app1.tar app1:latest'
                sh 'docker save -o app2.tar app2:latest'
            }
        }

        stage('Setup SSH on Bastion') {
            steps {
                sh 'chmod 600 $SSH_KEY'
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no $SSH_KEY ec2-user@18.220.201.109:/tmp/app_key'
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        chmod 600 /tmp/app_key
                    "
                '''
            }
        }

        stage('Transfer to Bastion') {
            steps {
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app1.tar ec2-user@18.220.201.109:/tmp/'
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app2.tar ec2-user@18.220.201.109:/tmp/'
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        scp -i /tmp/app_key -o StrictHostKeyChecking=no /tmp/app1.tar ec2-user@10.0.2.39:/tmp/
                        scp -i /tmp/app_key -o StrictHostKeyChecking=no /tmp/app2.tar ec2-user@10.0.3.250:/tmp/
                    "
                '''
            }
        }

        stage('Deploy App 1') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.2.39 '
                            sudo docker load -i /tmp/app1.tar
                            sudo docker stop app1 || true
                            sudo docker rm app1 || true
                            sudo docker run -d --name app1 -p 80:80 app1:latest
                            rm /tmp/app1.tar
                        '
                    "
                '''
            }
        }

        stage('Deploy App 2') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.3.250 '
                            sudo docker load -i /tmp/app2.tar
                            sudo docker stop app2 || true
                            sudo docker rm app2 || true
                            sudo docker run -d --name app2 -p 80:80 app2:latest
                            rm /tmp/app2.tar
                        '
                    "
                '''
            }
        }

        stage('Verify Deployments') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.2.39 '
                            echo \"App 1 Container Status:\"
                            sudo docker ps | grep app1
                        '
                    "

                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.3.250 '
                            echo \"App 2 Container Status:\"
                            sudo docker ps | grep app2
                        '
                    "
                '''
            }
        }

        stage('Collect Deployment Logs') {
            steps {
                sh '''
                    echo "Collecting deployment logs..."
                    # Get logs from App1
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.2.39 '
                            echo \"Collecting App1 logs...\"
                            sudo docker logs app1 > /tmp/app1-deployment.log 2>&1
                            
                            # Using put-log-events instead of push
                            if command -v aws &> /dev/null; then
                                # Create log group and stream if they don't exist
                                sudo aws logs create-log-group --log-group-name app-instance-logs || true
                                sudo aws logs create-log-stream --log-group-name app-instance-logs --log-stream-name app1-deployment-logs || true
                                
                                # Format log data for put-log-events
                                TIMESTAMP=$(date +%s)000
                                LOG_DATA=$(cat /tmp/app1-deployment.log | sed -e \"s/\\\"/\\\\\\\"/g\" -e \"s/^/{ \\\"timestamp\\\": $TIMESTAMP, \\\"message\\\": \\\"/\" -e \"s/$/\\\" },/\")
                                LOG_DATA=\"[${LOG_DATA%,}]\"
                                
                                # Send logs
                                echo "$LOG_DATA" > /tmp/formatted-logs.json
                                sudo aws logs put-log-events --log-group-name app-instance-logs --log-stream-name app1-deployment-logs --log-events file:///tmp/formatted-logs.json || echo "Failed to upload logs, but continuing"
                            else
                                echo "AWS CLI not found, skipping log upload"
                            fi
                        '
                    "

                    # Get logs from App2
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        ssh -i /tmp/app_key -o StrictHostKeyChecking=no ec2-user@10.0.3.250 '
                            echo \"Collecting App2 logs...\"
                            sudo docker logs app2 > /tmp/app2-deployment.log 2>&1
                            
                            # Using put-log-events instead of push
                            if command -v aws &> /dev/null; then
                                # Create log group and stream if they don't exist
                                sudo aws logs create-log-group --log-group-name app-instance-logs || true
                                sudo aws logs create-log-stream --log-group-name app-instance-logs --log-stream-name app2-deployment-logs || true
                                
                                # Format log data for put-log-events
                                TIMESTAMP=$(date +%s)000
                                LOG_DATA=$(cat /tmp/app2-deployment.log | sed -e \"s/\\\"/\\\\\\\"/g\" -e \"s/^/{ \\\"timestamp\\\": $TIMESTAMP, \\\"message\\\": \\\"/\" -e \"s/$/\\\" },/\")
                                LOG_DATA=\"[${LOG_DATA%,}]\"
                                
                                # Send logs
                                echo "$LOG_DATA" > /tmp/formatted-logs.json
                                sudo aws logs put-log-events --log-group-name app-instance-logs --log-stream-name app2-deployment-logs --log-events file:///tmp/formatted-logs.json || echo "Failed to upload logs, but continuing"
                            else
                                echo "AWS CLI not found, skipping log upload"
                            fi
                        '
                    "
                '''
            }
        }

        stage('Cleanup SSH Key') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                        rm -f /tmp/app_key || true
                    "
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment completed successfully!"
        }
        failure {
            echo "Deployment failed. Please check the logs for more details."
            sh '''
                ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@18.220.201.109 "
                    rm -f /tmp/app_key || true
                " || true
            '''
        }
        always {
            sh '''
                docker rmi app1:latest || true
                docker rmi app2:latest || true
                rm -f app1.tar || true
                rm -f app2.tar || true
            '''
            cleanWs()
        }
    }
}
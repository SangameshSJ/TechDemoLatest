pipeline {
    agent {
        docker {
            image 'docker:dind'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    
    environment {
        AWS_CREDENTIALS = credentials('aws-credentials')
        BASTION_HOST = "3.87.51.7"     // Pulumi Output -> bastion_public_ip
        APP1_HOST = "10.0.2.240"         // Pulumi Output -> app1_private_ip
        APP2_HOST = "10.0.3.189"          // Pulumi Output -> app2_private_ip
        SSH_KEY = credentials('bastion-key')
    }
    
    stages {
        stage('Install Docker') {
            steps {
                // This is a backup to ensure Docker is available if not provided by the image
                sh '''
                if ! command -v docker &> /dev/null; then
                    echo "Docker not found, installing..."
                    curl -fsSL https://get.docker.com -o get-docker.sh
                    sh get-docker.sh
                    sudo usermod -aG docker jenkins
                    sudo systemctl restart docker || true
                    # If running in container, Docker may already be available through host
                fi
                
                # Test Docker
                docker --version || echo "Docker installation failed but continuing..."
                '''
            }
        }
        
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/SangameshSJ/TechDemoLatest.git',
                    credentialsId: 'github-https-token'
            }
        }
        
        stage('Build App 1') {
            steps {
                dir('applications/app1') {
                    sh 'docker build -t app1:latest .'
                }
            }
        }
        
        stage('Build App 2') {
            steps {
                dir('applications/app2') {
                    sh 'docker build -t app2:latest .'
                }
            }
        }
        
        stage('Save Docker Images') {
            steps {
                sh 'docker save -o app1.tar app1:latest'
                sh 'docker save -o app2.tar app2:latest'
            }
        }
        
        stage('Transfer to Bastion') {
            steps {
                // Ensure key has correct permissions
                sh 'chmod 600 $SSH_KEY'
                
                // Copy docker images to bastion
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app1.tar ec2-user@${BASTION_HOST}:/tmp/'
                sh 'scp -i $SSH_KEY -o StrictHostKeyChecking=no app2.tar ec2-user@${BASTION_HOST}:/tmp/'
                
                // Copy docker images from bastion to app servers
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        scp -o StrictHostKeyChecking=no /tmp/app1.tar ec2-user@${APP1_HOST}:/tmp/
                        scp -o StrictHostKeyChecking=no /tmp/app2.tar ec2-user@${APP2_HOST}:/tmp/
                    "
                '''
            }
        }
        
        stage('Deploy App 1') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -o StrictHostKeyChecking=no ec2-user@${APP1_HOST} '
                            sudo docker load -i /tmp/app1.tar
                            sudo docker stop app1 || true
                            sudo docker rm app1 || true
                            sudo docker run -d --name app1 -p 80:80 app1:latest
                            rm /tmp/app1.tar
                        '
                    "
                '''
            }
        }
        
        stage('Deploy App 2') {
            steps {
                sh '''
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -o StrictHostKeyChecking=no ec2-user@${APP2_HOST} '
                            sudo docker load -i /tmp/app2.tar
                            sudo docker stop app2 || true
                            sudo docker rm app2 || true
                            sudo docker run -d --name app2 -p 80:80 app2:latest
                            rm /tmp/app2.tar
                        '
                    "
                '''
            }
        }
        
        stage('Verify Deployments') {
            steps {
                sh '''
                    # Verify App 1
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -o StrictHostKeyChecking=no ec2-user@${APP1_HOST} '
                            echo \"App 1 Container Status:\"
                            sudo docker ps | grep app1
                        '
                    "
                    
                    # Verify App 2
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no ec2-user@${BASTION_HOST} "
                        ssh -o StrictHostKeyChecking=no ec2-user@${APP2_HOST} '
                            echo \"App 2 Container Status:\"
                            sudo docker ps | grep app2
                        '
                    "
                '''
            }
        }
    }
    
    post {
        success {
            echo "Deployment completed successfully!"
        }
        failure {
            echo "Deployment failed. Please check the logs for more details."
        }
        always {
            // Clean up local docker images and tars
            sh '''
                docker rmi app1:latest || true
                docker rmi app2:latest || true
                rm -f app1.tar || true
                rm -f app2.tar || true
            '''
            cleanWs()
        }
    }
}